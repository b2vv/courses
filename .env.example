# Local development placeholders only. Replace before any shared deployment.
HTTP_PORT=8080
POSTGRES_DB=courses
POSTGRES_USER=courses
POSTGRES_PASSWORD=local-development-only
# Local Postgres has no TLS, so sslmode stays disable here. PRODUCTION MUST set
# POSTGRES_SSLMODE=verify-full (not merely require — require encrypts but does not
# authenticate the server, so a MITM stays open) with a CA bundle reachable by
# every DSN consumer (api, media-worker, asr-worker, upload, migrate). An empty
# value falls back to disable, so the prod value must be set explicitly.
POSTGRES_SSLMODE=disable
REDIS_PASSWORD=local-redis-only
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
# Public URL the payment provider can reach; use a tunnel for local callback testing.
PUBLIC_BASE_URL=http://localhost:8080
# WayForPay public test merchant (replace with merchant credentials outside local tests).
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_SECRET_KEY=
WAYFORPAY_MERCHANT_DOMAIN=localhost
COOKIE_SECURE=false
# Master key protecting two-factor secrets at rest: HKDF derives an AES-256-GCM key for the TOTP
# secret and an HMAC key for recovery-code hashes. Base64 of at least 32 random bytes; the service
# fails closed without it. PRODUCTION MUST set a real secret (e.g. `openssl rand -base64 32`); the
# value below is a non-secret local placeholder.
IDENTITY_2FA_SECRET_KEY=ZGV2LW9ubHktMmZhLW1hc3Rlci1rZXktbm90LWEtc2VjcmV0
# Hide the per-instructor analytics dimension when the platform has one instructor.
PLATFORM_SINGLE_INSTRUCTOR=true
