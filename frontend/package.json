    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "hls.js": "1.7.2",
    "i18next": "26.4.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.7",
