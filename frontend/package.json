{
  "name": "@courses/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --host 0.0.0.0",
    "build": "rsbuild build",
    "start": "node server.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings && node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
