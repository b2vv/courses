{
  "name": "@courses/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --host 0.0.0.0",
    "build": "rsbuild build",
    "start": "node server.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "e2e": "playwright test",
    "generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "i18next": "26.4.1",
    "react": "19.2.7",
    "react-aria-components": "1.21.0",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.13",
    "srvx": "1.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@rsbuild/core": "2.2.2",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@rstest/core": "0.11.11",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "axe-core": "4.13.0",
    "happy-dom": "20.13.2",
    "msw": "2.15.0",
    "orval": "8.27.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
