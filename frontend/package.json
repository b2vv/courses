    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@rstest/core": "0.11.11",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "axe-core": "4.13.0",
    "happy-dom": "20.13.2",
    "msw": "2.15.0",
    "orval": "8.27.0",
