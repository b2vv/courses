+      const req = Object.assign(new EventTarget(), { result: stored });
+      queueMicrotask(() => {
+        req.result = action();
+        req.dispatchEvent(new Event('success'));
+        queueMicrotask(() => tx.dispatchEvent(new Event('complete')));
+      });
+      return req;
+    };
+    return Object.assign(tx, {
+      objectStore: () => ({
+        put: (value: unknown) =>
+          request(() => {
+            stored = value;
+            return snapshot.key;
+          }),
+        get: () => request(() => stored),
+        delete: () =>
+          request(() => {
+            stored = undefined;
+          }),
+      }),
+    });
+  };
